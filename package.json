{
  "name": "automobile-stock",
  "version": "0.2.0",
  "private": true,
  "description": "Offline stock and invoicing desktop app for Etablissement Ben Mahmoud",
  "main": "out/main/index.js",
  "author": "Sofiene Zayati",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node scripts/run-integration-test.mjs",
    "test:ui": "npm run build && node scripts/run-ui-smoke-test.mjs",
    "verify": "npm run typecheck && npm run test:integration && npm run test:ui",
    "seed:starter": "node scripts/seed-starter-data.mjs",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:client": "npm run seed:starter && npm run build && electron-builder --win dir && node scripts/prepare-delivery.mjs",
    "electron:install": "install-electron --no",
    "postinstall": "npm run electron:install"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "tn.benmahmoud.automobilestock",
    "productName": "Ben Mahmoud Stock",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/initial-database.sqlite3",
        "to": "initial-database.sqlite3"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Ben Mahmoud Stock"
    },
    "portable": {
      "artifactName": "Ben-Mahmoud-Stock-Portable-${version}.${ext}"
    }
  }
}
